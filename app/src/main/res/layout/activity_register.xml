<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_graduation_cap"
            app:tint="#2563EB" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Create Account"
            android:textColor="#1E293B"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Join StudyBuddy to stay organized"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etRegName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="40dp"
            android:background="@android:color/transparent"
            android:hint="Full Name"
            android:textColorHint="#94A3B8"
            android:textColor="#1E293B"
            android:inputType="textPersonName"
            android:padding="12dp"
            android:drawableStart="@android:drawable/ic_menu_myplaces"
            android:drawablePadding="10dp"/>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E2E8F0" />

        <EditText
            android:id="@+id/etRegEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:hint="Email Address"
            android:textColorHint="#94A3B8"
            android:textColor="#1E293B"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:drawableStart="@android:drawable/ic_dialog_email"
            android:drawablePadding="10dp"/>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E2E8F0" />

        <EditText
            android:id="@+id/etRegPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:hint="Password"
            android:textColorHint="#94A3B8"
            android:textColor="#1E293B"
            android:inputType="textPassword"
            android:padding="12dp"
            android:drawableStart="@android:drawable/ic_lock_idle_lock"
            android:drawablePadding="10dp"/>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E2E8F0" />

        <EditText
            android:id="@+id/etRegConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:hint="Confirm Password"
            android:textColorHint="#94A3B8"
            android:textColor="#1E293B"
            android:inputType="textPassword"
            android:padding="12dp"
            android:drawableStart="@android:drawable/ic_lock_lock"
            android:drawablePadding="10dp"/>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E2E8F0" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#2563EB"
            android:text="Sign Up"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="12dp" />

        <TextView
            android:id="@+id/tvBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:text="Already have an account? Login"
            android:textColor="#2563EB"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>